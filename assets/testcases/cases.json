      "expected_house": {"build_year": 1974, "living_area_m2": 125, "building_type": "terraced", "renovation": "partially", "heat_distribution": "radiators", "fuel_type": "gas", "annual_fuel_kwh": 19500, "boiler_condensing": true, "occupants": 4, "dhw_by_boiler": true, "radiator_count": 9, "radiator_size": "large", "pipe_system": "two_pipe", "roof_insulated": true, "walls_insulated": false},
